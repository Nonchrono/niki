{
  "name": "niki",
  "version": "1.0.0",
  "description": "Niki rich text editor build and tests",
  "scripts": {
    "build": "esbuild ui-src/rich-editor.js --bundle --minify --format=iife --target=es2020 --outfile=ui/rich-editor.js --legal-comments=external && node scripts/editor-licenses.cjs",
    "test": "node tests/editor.test.cjs && node tests/auto-sync.test.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nonchrono/niki.git"
  },
  "type": "commonjs",
  "dependencies": {
    "@tiptap/core": "3.32.1",
    "@tiptap/extension-placeholder": "3.32.1",
    "@tiptap/extension-task-item": "3.32.1",
    "@tiptap/extension-task-list": "3.32.1",
    "@tiptap/markdown": "3.32.1",
    "@tiptap/starter-kit": "3.32.1",
    "marked": "17.0.6"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1"
  },
  "private": true
}
